# Server-side keys (Vercel → Project → Settings → Environment Variables,
# or a local .env.local file for `npm run dev`). All optional: users can
# also enter their own keys in the app's Settings tab.

ANTHROPIC_API_KEY=          # optional backup for AI listing copy (Gemini does it free)
ANTHROPIC_MODEL=claude-sonnet-5-5
GEMINI_API_KEY=             # free card recognition + AI listing copy at aistudio.google.com/apikey
GEMINI_MODEL=gemini-3.8-flash

# Set to true if you share the app publicly: server keys are ignored and
# every user must enter their own keys (so strangers don't use your quota).
REQUIRE_USER_KEYS=false
