# Server-side keys (Vercel → Project → Settings → Environment Variables,
# or a local .env.local file for `npm run dev`). All optional: users can
# also enter their own keys in the app's Settings tab.

ANTHROPIC_API_KEY=          # card recognition + AI listing copy
ANTHROPIC_MODEL=claude-sonnet-5-5
GEMINI_API_KEY=             # free card recognition at aistudio.google.com/apikey (used before Anthropic when set)
GEMINI_MODEL=gemini-2.5-flash
SPORTSCARDSPRO_TOKEN=       # sold-price guide by grade (paid)
EBAY_CLIENT_ID=             # eBay developer production App ID
EBAY_CLIENT_SECRET=         # eBay developer production Cert ID

# Set to true if you share the app publicly: server keys are ignored and
# every user must enter their own keys (so strangers don't use your quota).
REQUIRE_USER_KEYS=false
